{
  "name": "trash",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "deploy": "cf deploy",
    "favicon": "bun scripts/favicon.ts",
    "foldkit:source": "node scripts/foldkit-source.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@foldkit/ui": "0.170.0",
    "effect": "4.1.0",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.0",
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "cf": "^1.0.0-beta.26",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.2"
  }
}
